{
  "name": "@adminkit/vue",
  "version": "0.1.0",
  "type": "module",
  "description": "Vue 3 components for adminkit (Button/Input/Card) + variant resolver.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhlatky/UI-kit-poc.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "//private": "Guard, not a decision: nothing publishes by accident. Drop it when publishing becomes deliberate.",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "adminkit": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
