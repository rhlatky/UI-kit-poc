{
  "name": "adminkit",
  "version": "0.0.0",
  "type": "module",
  "description": "Plain CSS (BEM, source of truth) + generated typed class manifest + vanilla JS + shared variant core. No sass, no css-modules.",
  "exports": {
    "./tokens.css": "./src/css/tokens.css",
    "./button.css": "./src/css/button.css",
    "./input.css": "./src/css/input.css",
    "./card.css": "./src/css/card.css",
    "./variants": { "types": "./src/variants.d.ts", "default": "./src/variants.js" },
    "./classes/button": { "types": "./src/classes/button.d.ts", "default": "./src/classes/button.js" },
    "./classes/input": { "types": "./src/classes/input.d.ts", "default": "./src/classes/input.js" },
    "./classes/card": { "types": "./src/classes/card.d.ts", "default": "./src/classes/card.js" },
    "./dom": "./src/dom/index.js"
  },
  "files": ["src"],
  "scripts": { "gen": "node scripts/gen-classes.mjs" }
}
